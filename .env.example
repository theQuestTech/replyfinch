# API
DATABASE_URL=postgres://replyfinch:replyfinch@localhost:5432/replyfinch
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Comma-separated origins allowed to call the API (agent app + any site embedding the widget)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Email via Resend (optional): reply to offline messages and send chat transcripts
# RESEND_API_KEY=re_...
# EMAIL_FROM=Your Company <support@yourdomain.com>
# EMAIL_REPLY_TO=support@yourdomain.com
# Customers' replies back into tickets (Resend → Receiving, and a webhook for "email.received"):
# INBOUND_DOMAIN=abc123.resend.app
# RESEND_WEBHOOK_SECRET=whsec_...
# AI suggest (optional): without a key it runs in free mode (best matching saved reply)
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-haiku-5-5

# Agent web app (Vite)
VITE_API_URL=http://localhost:4000
